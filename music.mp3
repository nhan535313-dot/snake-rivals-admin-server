<!-- ===== SNAKE RIVALS MUSIC ===== -->
<div id="musicPanel">
  <button id="musicButton" onclick="toggleMusic()">🎵 Bật nhạc</button>
  <audio id="gameMusic" src="/music.mp3" loop preload="auto"></audio>
</div>
<script>
const gameMusic = document.getElementById("gameMusic");
const musicButton = document.getElementById("musicButton");
gameMusic.volume = 0.7;

async function toggleMusic() {
  if (gameMusic.paused) {
    try {
      await gameMusic.play();
      musicButton.textContent = "🔊 Tắt nhạc";
    } catch (error) {
      musicButton.textContent = "❌ Không phát được nhạc";
      console.error("Lỗi phát nhạc:", error);
    }
  } else {
    gameMusic.pause();
    musicButton.textContent = "🎵 Bật nhạc";
  }
}

gameMusic.addEventListener("play", () => {
  musicButton.textContent = "🔊 Tắt nhạc";
});
gameMusic.addEventListener("pause", () => {
  musicButton.textContent = "🎵 Bật nhạc";
});
</script>
